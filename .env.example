# Africa's Talking — from your app dashboard (Settings → API Key)
AT_USERNAME=sandbox
AT_API_KEY=
# SMS sender. Leave EMPTY in sandbox (AT uses its default; "AFTKNG" is rejected as InvalidSenderId).
# For two-way SMS set it to your sandbox shortcode (SMS -> Shortcodes) so parents can reply.
AT_SENDER_ID=
# USSD code assigned to your USSD channel, e.g. *384*1234#
AT_USSD_CODE=

DATABASE_URL=sqlite:///./bakishule.db
# Keep true until credentials are filled in; set false to really send SMS/airtime
DRY_RUN=true
DEMO_MODE=true
DEMO_TEACHER_PHONE=+254700000001
DEMO_PARENT_PHONE=+254700000002
DEFAULT_LANGUAGE=en
AIRTIME_REWARD_KES=20

# Parent SMS/USSD queries
DEMO_GUARDIAN_PIN=1234
PARENT_DAILY_QUERY_LIMIT=10
TIMEZONE=Africa/Nairobi
# Weekly REPORT SMS every Friday 16:00 (TIMEZONE)
ENABLE_SCHEDULER=true
# Emojis in SMS replies (plain-text fallback when a reply would exceed 2 segments)
SMS_USE_EMOJI=true

# AI chat: free-text parent SMS answered by Claude (see PRIVACY.md). Never commit a real key.
ANTHROPIC_API_KEY=
AI_CHAT_ENABLED=true
AI_MODEL=claude-opus-5-5
